# ============================================================
# Value Betting Engine — Environment Variables Template
# ============================================================
# Copy this file to `.env` and fill in your real values.
# NEVER commit `.env` to version control — it is gitignored.

# --- Odds Provider (choose one) ---
ODDS_PROVIDER=theodds           # "theodds" or "oddsjam"

# --- The Odds API (https://the-odds-api.com) ---
# Free tier includes NBA, WNBA, MLB, and EPL odds.
THE_ODDS_API_KEY=your_theodds_api_key_here

# --- OddsJam API (https://oddsjam.com) ---
ODDSJAM_API_KEY=your_oddsjam_api_key_here

# --- nba_api throttle (NBA & WNBA history) ---
NBA_API_CALLS_PER_MINUTE=20
NBA_API_TIMEOUT=60

# --- Model artefacts directory ---
MODEL_DIR=artefacts

# --- Web app database (SQLite; defaults to webapp/data/app.db) ---
# BETS_DB_PATH=webapp/data/app.db

# --- Portfolio constraints (override config/settings.py defaults) ---
MAX_PORTFOLIO_KELLY_FRACTION=0.25
MAX_SINGLE_BET_FRACTION=0.05
CORRELATION_SHRINKAGE_ALPHA=0.1

# --- Whale tracker (python -m whale_tracker watch) ---
# Polymarket and Kalshi reads are public; no API keys needed.
# WHALE_PLATFORMS=polymarket,kalshi
# WHALE_MIN_USD=10000                 # single-trade whale threshold (Polymarket)
# WHALE_KALSHI_MIN_USD=10000          # defaults to WHALE_MIN_USD
# WHALE_POLYMARKET_FLOOR_USD=1000     # smaller fills are pulled to catch split orders
# WHALE_WATCH_MIN_USD=1000            # alert bar for wallets you follow
# WHALE_POLL_SECONDS=30
# WHALE_DB_PATH=data/whales.db
# Alert channels (any combination; the terminal always gets alerts):
# WHALE_DISCORD_WEBHOOK_URL=
# WHALE_SLACK_WEBHOOK_URL=
# WHALE_NTFY_TOPIC=                   # phone push: install the ntfy app, subscribe to this topic
# WHALE_TELEGRAM_BOT_TOKEN=
# WHALE_TELEGRAM_CHAT_ID=

# --- Copy trader (python -m copy_trader) ---
# Polymarket only: Kalshi's public API doesn't identify traders.
# COPY_BANKROLL_USD=1000             # sizes every order you're told to place
# COPY_SCALE=1.0                     # 1.0 = same share of your bankroll as their trade is of their portfolio
# COPY_MAX_POSITION_PCT=0.05         # cap per copied position
# COPY_MIN_RESOLVED=30               # who qualifies to be copied:
# COPY_MIN_WIN_RATE=0.60
# COPY_MIN_EDGE=0.05                 # win rate minus average price paid
# COPY_MIN_PROFIT_USD=50000
# COPY_MAX_CHASE=0.05                # skip if price ran more than 5c past their entry
# COPY_MIN_SIGNAL_USD=500            # ignore their moves smaller than this
# COPY_POLL_SECONDS=60
# COPY_DB_PATH=data/copytrader.db
# COPY_DISCORD_WEBHOOK_URL=
# COPY_SLACK_WEBHOOK_URL=
# COPY_NTFY_TOPIC=
# COPY_TELEGRAM_BOT_TOKEN=
# COPY_TELEGRAM_CHAT_ID=
